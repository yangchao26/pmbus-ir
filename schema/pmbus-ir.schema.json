{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yangchao26/pmbus-ir/main/schema/pmbus-ir.schema.json",
  "title": "PMBus IR",
  "description": "PMBus IR v0.1 YAML document schema: shared root structure, source provenance, command and data-format schemas. Product-specific extensions remain explicit and semantically checked.",
  "type": "object",
  "required": [
    "ir_version",
    "device"
  ],
  "properties": {
    "ir_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "document": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "reference_implementation",
            "device_implementation",
            "experimental"
          ]
        },
        "status": {
          "type": "string"
        },
        "canonical_format": {
          "const": "yaml"
        },
        "completeness": {
          "type": "object",
          "properties": {
            "supported_commands": {
              "type": "string"
            },
            "supported_command_count": {
              "type": "integer",
              "minimum": 0
            },
            "behavioral_details": {
              "type": "string"
            },
            "undocumented_fields": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "document": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "filename": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "device": {
      "type": "object",
      "required": [
        "manufacturer",
        "model"
      ],
      "properties": {
        "manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "standards": {
      "type": "object",
      "properties": {
        "pmbus": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "transport": {
      "type": "object",
      "properties": {
        "interface": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "addressing": {
      "type": "object",
      "properties": {
        "theoretical_address_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "reserved_addresses_decimal": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "uniqueItems": true
        },
        "logical_outputs": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "data_formats": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "data-format.schema.json"
      }
    },
    "commands": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "command.schema.json"
      }
    },
    "telemetry": {
      "type": "object"
    },
    "configuration": {
      "type": "object"
    },
    "status": {
      "type": "object"
    },
    "faults": {
      "type": "object"
    },
    "persistence": {
      "type": "object"
    },
    "behavior": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    },
    "source_conflicts": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "document": {
            "properties": {
              "kind": {
                "const": "reference_implementation"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "required": [
          "document"
        ]
      },
      "then": {
        "required": [
          "source",
          "commands"
        ]
      }
    }
  ]
}
